{
  "name": "frogio-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "assets:generate": "node tools/frog-palettes.mjs",
    "assets:check": "node tools/frog-palettes.mjs --check",
    "ui:check": "node tools/check-ui.mjs",
    "assets:prepare": "python tools/prepare_match_assets.py"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@microsoft/signalr-protocol-msgpack": "^8.0.7",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.10"
  }
}
